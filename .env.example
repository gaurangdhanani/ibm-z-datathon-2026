# Copy to .env for local overrides. Every variable is optional; defaults are dev-safe.
# All settings are read by onetrace/config.py (prefix ONETRACE_).

ONETRACE_ENV=dev                      # dev | test | prod
ONETRACE_DEMO_MODE=true               # enables one-click demo personas on /api/auth/demo-login
ONETRACE_SECRET_KEY=dev-only-change-me-in-prod   # also derives the KMS master key: change it, then `make seed`
ONETRACE_DATABASE_URL=sqlite:///./data/onetrace.db
ONETRACE_SESSION_TTL_MINUTES=720
ONETRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ONETRACE_STATIC_DIR=frontend/dist
ONETRACE_LOG_LEVEL=info
ONETRACE_TIMEZONE=America/Chicago     # off-hours rule (22:00-06:00) is judged in this zone
ONETRACE_EMERGENCY_TTL_MINUTES=60     # break-glass access expires after this
