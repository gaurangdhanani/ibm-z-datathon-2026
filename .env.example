# Copy to .env for local overrides. Every variable is optional; defaults are dev-safe.
# All settings are read by medvault/config.py (prefix MEDVAULT_).

MEDVAULT_ENV=dev                      # dev | test | prod
MEDVAULT_DEMO_MODE=true               # enables one-click demo personas on /api/auth/demo-login
MEDVAULT_SECRET_KEY=dev-only-change-me-in-prod
MEDVAULT_DATABASE_URL=sqlite:///./data/medvault.db
MEDVAULT_SESSION_TTL_MINUTES=720
MEDVAULT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDVAULT_STATIC_DIR=frontend/dist
MEDVAULT_LOG_LEVEL=info
